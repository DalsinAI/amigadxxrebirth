; $VER: Install-Descent 0.61.0-amiga2 (6.11.2026)
; The Amiga Installer script for Descent, an AmiCradle game port.
; Made by amicradle scripts/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the Descent drawer where the archive was unpacked.

(set @app-name "Descent")
(set #version "0.61.0-amiga2")
(set #drawer "Descent")
(set #program "Descent")
(set #space 11719)  ; KB

(onerror
    (message (cat "Descent was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-Descent again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "Descent needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "Descent needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "Descent needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The Descent drawer is not beside Install-Descent. Unpack the whole archive, then run Install-Descent from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The Descent drawer has no Descent in it. Unpack the whole archive again."))

(welcome "This installs Descent 0.61.0-amiga2 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the Descent drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called Descent in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": Descent needs 12 MB free.")))

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "Data") (noreq))
    (set #kept (if (= #kept "") "Data" (cat #kept "|" "Data"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying Descent")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating Descent. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "Descent.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "Descent.info")))

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. Descent would have gone in " #dest "."))
    (message (cat "Descent 0.61.0-amiga2 is installed in " #dest "."
                  "\n\nTo start it, open the Descent drawer and double-click the Descent icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
